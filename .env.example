# Copy to .env, then run: docker compose up --build

# --- Gateway (validated at boot by packages/gateway/src/config.ts) ---
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Used when running the gateway outside Docker (pnpm --filter @gw/gateway dev).
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://gateway:gateway@localhost:5442/gateway
REDIS_URL=redis://localhost:6389
# Master key for envelope-encrypting provider credentials: 32 bytes, base64.
# DEV ONLY value below; generate a real one with: openssl rand -base64 32
GATEWAY_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
GATEWAY_MASTER_KEY_VERSION=1
# While rotating: the old key(s) as <version>:<base64>, comma-separated. Remove after re-encrypt.
GATEWAY_PREVIOUS_MASTER_KEYS=
# Largest accepted request body (bytes) and overall upstream deadline (ms).
REQUEST_BODY_LIMIT_BYTES=1048576
PROVIDER_TIMEOUT_MS=60000
# Registers the keyless `mock` provider (models: mock/<anything>). Compose sets this for you.
MOCK_PROVIDER_BASE_URL=http://localhost:4000/v1
# Default OpenAI-compatible endpoint for local/<model> (Ollama/vLLM). Compose sets this for you.
LOCAL_MODELS_BASE_URL=http://localhost:11434/v1
# Set to true behind a trusted proxy (Fly.io) so per-IP limits see the client address.
TRUST_PROXY=false
# How long /readyz waits for each dependency before reporting it as failing.
READINESS_TIMEOUT_MS=1000

# --- Local stack (docker-compose.yml) ---
# Host ports are bound to 127.0.0.1 and offset from the defaults (5432, 6379) to avoid clashing
# with other local databases.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
POSTGRES_PORT=5442
REDIS_PORT=6389
GATEWAY_PORT=3000
MOCK_PROVIDER_PORT=4000
# Grafana UI (anonymous admin, local only).
GRAFANA_PORT=3001
OLLAMA_PORT=11434
