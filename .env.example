# Copy to .env, then run: docker compose up --build

# --- Gateway (validated at boot by packages/gateway/src/config.ts) ---
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Used when running the gateway outside Docker (pnpm --filter @gw/gateway dev).
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://gateway:gateway@localhost:5442/gateway
REDIS_URL=redis://localhost:6389
# Master key for envelope-encrypting provider credentials: 32 bytes, base64.
# DEV ONLY value below; generate a real one with: openssl rand -base64 32
GATEWAY_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
GATEWAY_MASTER_KEY_VERSION=1
# While rotating: the old key(s) as <version>:<base64>, comma-separated. Remove after re-encrypt.
GATEWAY_PREVIOUS_MASTER_KEYS=
# Largest accepted request body (bytes).
REQUEST_BODY_LIMIT_BYTES=1048576
# Request deadline when the client sends no x-gateway-timeout-ms, and the cap on that header.
REQUEST_DEADLINE_DEFAULT_MS=60000
REQUEST_DEADLINE_MAX_MS=300000
# Provider connect timeout, and the upper bound for one non-streaming attempt (covers generation).
PROVIDER_CONNECT_TIMEOUT_MS=3000
PROVIDER_ATTEMPT_TIMEOUT_MS=60000
# Streaming: first-token timeout per attempt, idle timeout after the first byte, heartbeat interval.
PROVIDER_FIRST_TOKEN_TIMEOUT_MS=20000
STREAM_IDLE_TIMEOUT_MS=30000
STREAM_HEARTBEAT_MS=15000
# Retries per candidate for retryable errors; full-jitter exponential backoff.
RETRY_MAX_RETRIES=2
RETRY_BACKOFF_BASE_MS=200
RETRY_BACKOFF_CAP_MS=2000
# Registers the keyless `mock` provider (models: mock/<anything>). Compose sets this for you.
MOCK_PROVIDER_BASE_URL=http://localhost:4000/v1
# OpenAI-compatible endpoint for local/<model> (Ollama/vLLM). Leave empty to hide local models.
# From the host: http://localhost:11434/v1. Inside compose: http://ollama:11434/v1
LOCAL_MODELS_BASE_URL=
# Usage metering: spill file for events queued while Redis is down; worker retry policy.
USAGE_SPILL_PATH=./data/usage-spill.ndjson
USAGE_JOB_ATTEMPTS=5
USAGE_JOB_BACKOFF_MS=5000
# Hard budgets: reservation lease (refunded if never settled), sweep and reconciliation intervals.
BUDGET_LEASE_MS=600000
BUDGET_SWEEP_INTERVAL_MS=60000
BUDGET_RECONCILE_INTERVAL_MS=300000
# Optional bearer token protecting GET /metrics.
# METRICS_TOKEN=
# Cost-aware routing of virtual models (auto, gw/*); tenants can override via settings.flags.
FF_COST_AWARE_ROUTING=true
# Tracing: OTLP endpoint (compose points it at the collector), head sampling ratio for the gateway,
# and the collector's tail-sampling percentage for successful traces (errors are always kept).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=1
TRACE_SAMPLE_PERCENT=100
# Development-only debugging: log prompts at debug level. Ignored unless NODE_ENV=development.
LOG_PROMPTS=false
# Set to true behind a trusted proxy (Fly.io) so per-IP limits see the client address.
TRUST_PROXY=false
# How long /readyz waits for each dependency before reporting it as failing.
READINESS_TIMEOUT_MS=1000

# --- Local stack (docker-compose.yml) ---
# Host ports are bound to 127.0.0.1 and offset from the defaults (5432, 6379) to avoid clashing
# with other local databases.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
POSTGRES_PORT=5442
REDIS_PORT=6389
GATEWAY_PORT=3000
MOCK_PROVIDER_PORT=4000
# Grafana UI (anonymous admin, local only).
GRAFANA_PORT=3001
OLLAMA_PORT=11434
