{
  "name": "@gw/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "catalog"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=@gw/source --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migrate:dev": "node --conditions=@gw/source --import tsx src/db/migrate.ts",
    "cli": "node dist/cli.js",
    "cli:dev": "node --conditions=@gw/source --import tsx src/cli.ts",
    "seed:catalog": "node dist/catalog/seed.js",
    "seed:catalog:dev": "node --conditions=@gw/source --import tsx src/catalog/seed.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "node --conditions=@gw/source --import tsx --watch src/worker.ts"
  },
  "devDependencies": {
    "@gw/mock-provider": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "openai": "^7.33.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@gw/schema": "workspace:*",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "js-tiktoken": "^1.0.21",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "undici": "^8.12.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
