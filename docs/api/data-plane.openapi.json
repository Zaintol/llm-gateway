{
  "openapi": "3.1.0",
  "info": {
    "title": "LLM gateway data-plane API",
    "version": "0.1.0",
    "description": "OpenAI-compatible. Point an OpenAI SDK at <gateway>/v1 with a gateway API key."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Create a chat completion (streaming with stream: true)",
        "parameters": [
          {
            "name": "x-gateway-timeout-ms",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300000
            },
            "description": "Request deadline (default 60000, capped at 300000)"
          },
          {
            "name": "traceparent",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "W3C trace context to continue"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "messages": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "role": {
                              "type": "string",
                              "const": "system"
                            },
                            "content": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
