                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "max_tokens": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "stop": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "stream_options": {
                    "type": "object",
                    "properties": {
                      "include_usage": {
                        "type": "boolean"
                      }
                    }
                  },
                  "user": {
                    "type": "string"
                  },
                  "gateway": {
                    "type": "object",
                    "properties": {
                      "min_quality_tier": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3
                      },
                      "latency_tier": {
                        "type": "string",
                        "enum": [
                          "fast",
                          "standard",
                          "slow"
                        ]
                      },
                      "max_cost_usd": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "fallback": {
                        "type": "boolean"
                      }
                    }
                  }
