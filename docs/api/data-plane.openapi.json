                                                  "auto",
                                                  "low",
                                                  "high"
                                                ]
                                              }
                                            },
                                            "required": [
                                              "url"
                                            ]
                                          }
                                        },
                                        "required": [
                                          "type",
                                          "image_url"
                                        ]
                                      }
                                    ]
                                  }
                                }
                              ]
