              "x-gateway-model": {
                "schema": {
                  "type": "string"
                }
              },
              "x-gateway-attempts": {
                "schema": {
                  "type": "string"
                }
              },
              "x-gateway-route-reason": {
                "schema": {
                  "type": "string"
                }
              },
              "x-gateway-deadline-ms": {
                "schema": {
                  "type": "string"
                }
              },
              "x-gateway-emulated": {
                "schema": {
                  "type": "string"
                }
              },
              "x-ratelimit-limit-requests": {
                "schema": {
                  "type": "string"
                }
              },
              "x-ratelimit-remaining-requests": {
                "schema": {
                  "type": "string"
                }
              },
              "x-ratelimit-limit-tokens": {
                "schema": {
                  "type": "string"
                }
              },
              "x-ratelimit-remaining-tokens": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
